{
  "dataRoles": [
    {
      "displayName": "Value",
      "displayNameKey": "Role_Value",
      "name": "measure",
      "kind": "Measure",
      "description": "Current period value (required).",
      "descriptionKey": "Role_Value_Description"
    },
    {
      "displayName": "Prior Period",
      "displayNameKey": "Role_PriorPeriod",
      "name": "priorPeriod",
      "kind": "Measure",
      "description": "Prior period value for variance calculation (optional).",
      "descriptionKey": "Role_PriorPeriod_Description"
    },
    {
      "displayName": "Target",
      "displayNameKey": "Role_Target",
      "name": "target",
      "kind": "Measure",
      "description": "Target or budget value (optional).",
      "descriptionKey": "Role_Target_Description"
    },
    {
      "name": "image",
      "displayName": "Image",
      "description": "A column holding a Base64 data URI (data:image/*;base64,...). Shown in the top-right of each card. External URLs are rejected: the visual makes no network requests.",
      "kind": "Measure",
      "displayNameKey": "Role_Image",
      "descriptionKey": "Role_Image_Description"
    },
    {
      "displayName": "Small Multiples (Pro)",
      "description": "Dimension to split into multiple KPI cards (optional, Pro).",
      "displayNameKey": "Role_SmallMultiples",
      "name": "smallMultiples",
      "kind": "Grouping",
      "descriptionKey": "Role_SmallMultiples_Description"
    },
    {
      "name": "trend",
      "displayName": "Trend (Pro)",
      "description": "A date or ordered field. Draws a trend line inside each card, over this axis.",
      "kind": "Grouping",
      "displayNameKey": "Role_Trend",
      "descriptionKey": "Role_Trend_Description"
    },
    {
      "displayName": "Tooltips (Pro)",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Additional measures for tooltip (optional, Pro).",
      "descriptionKey": "Role_Tooltips_Description"
    },
    {
      "displayName": "Secondary KPIs (Pro)",
      "displayNameKey": "Role_SecondaryKpis",
      "name": "secondaryKpis",
      "kind": "Measure",
      "description": "Up to 3 supporting measures, shown stacked beside the main value.",
      "descriptionKey": "Role_SecondaryKpis_Description"
    },
    {
      "displayName": "Secondary KPIs prior (Pro)",
      "displayNameKey": "Role_SecondaryPrior",
      "name": "secondaryPrior",
      "kind": "Measure",
      "description": "Prior-period value for each Secondary KPI, matched by position: the first here pairs with the first Secondary KPI.",
      "descriptionKey": "Role_SecondaryPrior_Description"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "measure": {
            "max": 1
          },
          "priorPeriod": {
            "max": 1
          },
          "smallMultiples": {
            "max": 1
          },
          "tooltips": {
            "max": 10
          },
          "secondaryKpis": {
            "max": 3
          },
          "secondaryPrior": {
            "max": 3
          },
          "target": {
            "max": 1
          },
          "trend": {
            "max": 1
          },
          "image": {
            "max": 1
          }
        }
      ],
      "matrix": {
        "rows": {
          "select": [
            {
              "for": {
                "in": "smallMultiples"
              }
            },
            {
              "for": {
                "in": "trend"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "measure"
              }
            },
            {
              "bind": {
                "to": "target"
              }
            },
            {
              "bind": {
                "to": "priorPeriod"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            },
            {
              "bind": {
                "to": "image"
              }
            },
            {
              "bind": {
                "to": "secondaryKpis"
              }
            },
            {
              "bind": {
                "to": "secondaryPrior"
              }
            }
          ]
        }
      }
    }
  ],
